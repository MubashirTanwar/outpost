# Path to a native Stockfish binary (brew install stockfish / apt install stockfish),
# or a command such as "node /path/to/stockfish.js" for the WASM build.
STOCKFISH_PATH=stockfish
ENGINE_DEPTH=18
BACKFILL_DEPTH=14
ENGINE_THREADS=2

# Leave empty to use the in-memory graph (no persistence). docker compose sets this for you.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chesscoach

# anthropic | ollama | none
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

CORS_ORIGINS=*
