# Where the Python API runs. Leave unset on Vercel to use browser-only mode
# (in-browser Stockfish review, no agents / graph DB), or point it at a reachable backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Postgres for everything the app saves (reviews, puzzles, progress…), server-side only.
# On Vercel + Supabase use the Transaction pooler URL (Supabase → Connect), not db.<ref>.supabase.co,
# which is IPv6-only. Tables are created on the first request; db/schema.sql has the same SQL.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Admin panel at /admin (NextAuth, one password). Without both, /admin stays locked.
# ADMIN_PASSWORD=pick-a-long-password
# NEXTAUTH_SECRET=   # any long random string: openssl rand -base64 32
# NEXTAUTH_URL=https://chess-outpost.vercel.app   # optional on Vercel
